# Stripe server secret. Keep this server-only.
STRIPE_SECRET_KEY=

# Included for Stripe.js / future client-side additions.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical public site URL, for example https://keepherlightalive.com
NEXT_PUBLIC_SITE_URL=https://keepherlightalive.com

# Stripe webhook signing secret for /shop/api/stripe/webhook. Server-only.
STRIPE_WEBHOOK_SECRET=

# A live Stripe key is refused unless this is exactly "true". Set it only in
# the production environment, never on previews.
SHOP_LIVE_PAYMENTS=

# KHLA Store Supabase project. The service-role key is server-only: never give
# it a NEXT_PUBLIC_ name.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hygraph content API (published stage, read-only token).
HYGRAPH_ENDPOINT=
HYGRAPH_TOKEN=

# Where the foundation website lives, when it is not at the same origin root.
# Leave unset for a single-origin deploy (static site at /, shop at /shop).
NEXT_PUBLIC_FOUNDATION_URL=

# Flip to "true" only when the Foundation has confirmed real prices. Until then
# the storefront shows the preview banner and refuses to quote a sellable price.
SHOP_OPEN=false
